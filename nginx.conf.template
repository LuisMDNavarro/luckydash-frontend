server {
    listen 80;
    server_name _;

    # Let's Encrypt certificate validation
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    # Redirigir el resto del tráfico a HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/letsencrypt/live/98.87.89.82-prod/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/98.87.89.82-prod/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    # React
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Django Admin
    location /admin/ {
        proxy_pass ${BACKEND_URL}/admin/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django static files / WhiteNoise
    location /static/ {
        proxy_pass ${BACKEND_URL}/static/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/admin/ {
        return 404;
    }

    # Django API
    location /api/ {
        proxy_pass ${BACKEND_URL}/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}